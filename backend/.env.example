# GitMusic Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── GitHub API ──────────────────────────────────────────────────────────────
# Create a personal access token at https://github.com/settings/tokens
# Required scope: read:user (for public contribution data)
GITHUB_TOKEN=your_github_token_here

# ── Development ──────────────────────────────────────────────────────────────
# Set to "true" to use mock GitHub data (no token required)
MOCK_GITHUB=false

# ── Session ──────────────────────────────────────────────────────────────────
# How long (in seconds) a session can be idle before auto-release
SESSION_TIMEOUT_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# In production, set this to your frontend domain(s).
# Use "*" only in development.
ALLOWED_ORIGINS=*
